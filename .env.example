# NexVora AI Workspace - local build configuration.
# Copy this file to `.env` (git-ignored) before building:   cp .env.example .env
#
# Only needed to sign RELEASE builds with your own keystore (android/app/nexvora-upload-key.keystore).
# Debug builds (`yarn android` / `./gradlew assembleDebug`) do not use these values, but the file must exist.
# NEVER commit real passwords or API keys. AI provider keys are entered inside the app and stored in the
# device keystore (react-native-keychain) - they are not configured here.
APP_RELEASE_STORE_PASSWORD=
APP_RELEASE_KEY_PASSWORD=
