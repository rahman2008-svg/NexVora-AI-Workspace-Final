<?xml version="1.0" encoding="utf-8"?>
<!--
  NexVora AI Workspace keeps chats, documents, vectors, downloaded models and settings strictly on the device.
  Nothing is included in cloud backup or device-to-device transfer. (android:allowBackup is also false.)
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
